# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_INCIDENT_CHANNEL_ID=C0123456789

# --- GitHub ---
# Fine-grained PAT with Contents: Read/Write and Pull requests: Read/Write,
# scoped to the org below (or the specific repos in it).
GITHUB_TOKEN=ghp_...
# The repo for an incident is computed as f"{GITHUB_ORG}/{namespace}" - the
# cluster/namespace come dynamically from the Slack message itself, this
# assumes your k8s namespace names match your GitHub repo names exactly.
GITHUB_ORG=your-org

# --- AWS / EKS ---
# No AWS keys needed here - credentials come from the EC2 instance role
# (IMDSv2). Set this to the region your EKS clusters are in.
AWS_REGION=us-east-1

# --- Claude CLI ---
# The `claude` binary must already be on PATH and logged in (claude login) for
# the user this process runs as. No API key is used - it rides the existing
# CLI session.
CLAUDE_BIN=claude

# --- Working directories ---
WORKDIR=/opt/anomaly-agent/work
STATE_DIR=/opt/anomaly-agent/state

# --- Incident handling ---
INCIDENT_COOLDOWN_MINUTES=30
