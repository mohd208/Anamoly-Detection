# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_INCIDENT_CHANNEL_ID=C0123456789

# --- GitHub ---
# Fine-grained PAT scoped to only the repos in config/repo-map.yaml,
# with Contents: Read/Write and Pull requests: Read/Write.
GITHUB_TOKEN=ghp_...

# --- Claude CLI ---
# The `claude` binary must already be on PATH and logged in (claude login) for
# the user this process runs as. No API key is used - it rides the existing
# CLI session.
CLAUDE_BIN=claude

# --- Working directories ---
WORKDIR=/opt/anomaly-agent/work
STATE_DIR=/opt/anomaly-agent/state

# --- Incident handling ---
INCIDENT_COOLDOWN_MINUTES=30

# --- AWS / EKS ---
# No AWS keys needed here - credentials come from the EC2 instance role
# (IMDSv2). Each cluster's region is read from config/repo-map.yaml instead.
