# anomaly-agent configuration
# Copy this file to .env and fill in the REQUIRED section. Everything else
# has a sensible default and only needs uncommenting if you want to change it.

# ============================== REQUIRED ==============================

# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_INCIDENT_CHANNEL_ID=C0123456789

# --- GitHub ---
# Fine-grained PAT with Contents: Read/Write and Pull requests: Read/Write.
GITHUB_TOKEN=ghp_...
GITHUB_ORG=your-org

# ============================== OPTIONAL ==============================

# --- GitHub repo override ---
# Pins EVERY incident to one fixed repo regardless of namespace - handy for
# testing, or if you only have a single repo right now. Leave commented out
# to use the dynamic "{GITHUB_ORG}/{namespace}" resolution instead.
# GITHUB_REPO=your-org/your-repo

# --- AWS / EKS ---
# No AWS keys needed - credentials come from the EC2 instance role (IMDSv2),
# and it self-grants EKS access per cluster on first use (app/k8s.py).
# Just set the region your EKS clusters live in.
AWS_REGION=us-east-1

# --- Claude CLI ---
# Must already be on PATH and logged in (claude login) as this process's
# user. No API key used - it rides the existing CLI session.
CLAUDE_BIN=claude

# --- Paths ---
WORKDIR=/opt/anomaly-agent/work
STATE_DIR=/opt/anomaly-agent/state
# FIX_PATHS_PATH=/opt/anomaly-agent/config/fix-paths.yaml

# --- Incident handling ---
INCIDENT_COOLDOWN_MINUTES=30

# --- Health server ---
# Port for the FastAPI/uvicorn /health endpoint. The Slack Socket Mode
# listener itself makes no inbound connections - this is only for uniform
# process management alongside your other FastAPI-based agents.
# PORT=8000
