{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EksReadOnlyDescribe",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:ListClusters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EksSelfGrantAccessEntry",
      "Effect": "Allow",
      "Action": [
        "eks:CreateAccessEntry",
        "eks:AssociateAccessPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OptionalSecretsRead",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:anomaly-agent/*"
    }
  ]
}
